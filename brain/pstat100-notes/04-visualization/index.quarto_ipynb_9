     "output_type": "display_data"
    }
   ],
   "source": [
    "#| fig-cap: \"Box plot with strip plot overlay (seaborn).\"\n",
    "#| fig-align: center\n",
    "ax = sns.boxplot(\n",
    "    x=\"bill_length_mm\", y=\"species\",\n",
    "    data=penguins,\n",
    "    color=\"lightsteelblue\"\n",
    ")\n",
    "sns.stripplot(\n",
    "    x=\"bill_length_mm\", y=\"species\",\n",
    "    data=penguins,\n",
    "    color=\"black\",\n",
    "    alpha=0.5,\n",
    "    size=4,\n",
    "    ax=ax\n",
