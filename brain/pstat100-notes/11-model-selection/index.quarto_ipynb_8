    "#| fig-cap: \"The bias-variance tradeoff. As model complexity grows, bias falls but variance rises. The optimal complexity minimises total test error.\"\n",
    "#| echo: false\n",
    "complexity   = np.linspace(1, 15, 200)\n",
    "bias2        = 5 * np.exp(-0.35 * complexity)\n",
    "variance     = 0.05 * np.exp(0.30 * complexity)\n",
    "irreducible  = 0.5 * np.ones_like(complexity)\n",
    "total        = bias2 + variance + irreducible\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 5))\n",
    "ax.plot(complexity, bias2,      lw=2.5, color='steelblue', label='Bias²')\n",
    "ax.plot(complexity, variance,   lw=2.5, color='#fc8d62',   label='Variance')\n",
    "ax.plot(complexity, irreducible,lw=1.5, color='gray', linestyle='--',\n",
    "        label='Irreducible error')\n",
    "ax.plot(complexity, total,      lw=3,   color='#8da0cb',   label='Total test error')\n",
    "opt = np.argmin(total)\n",
    "ax.axvline(complexity[opt], color='crimson', lw=1.5, linestyle=':',\n",
    "           label='Optimal complexity')\n",
    "ax.set_xlabel('Model Complexity (number of predictors)', fontsize=12)\n",
    "ax.set_ylabel('Error', fontsize=12)\n",
    "ax.set_title('The Bias-Variance Tradeoff', fontsize=13)\n",
    "ax.legend(fontsize=10)\n",
    "plt.tight_layout()\n",
    "plt.show()"
