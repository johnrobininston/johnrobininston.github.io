)
# Server
server <- function(input, output) {
output$phiPlot <- renderPlot({
p_vals <- seq(0.1, 3, length.out = 200)
results <- do.call(rbind, lapply(p_vals, function(p) {
continuous_uniform_productivity(p, input$n, input$N, input$A, input$B, input$alpha, input$a, input$q)
}))
ggplot(results, aes(x = p, y = phi)) +
geom_line(size = .5) +
labs(
title = "Phi vs p",
x = "p",
y = expression(phi)
)  # larger font for clarity
}, res = 120)  # Higher resolution: default is 72; 120 is sharper
}
