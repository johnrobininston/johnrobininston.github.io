library(tidyverse)
library(shiny)
continuous_uniform_productivity <- function(p, n, N, A, B, alpha, a, q){
# Compute variables
xi <- alpha/(p*a + q)
beta = 1-alpha
# Compute min and max terms
term1 <- n*ifelse(n<=(xi*A)^(1/beta), 0, ifelse(n>=(xi*B)^(1/beta), 1, (n^beta-xi*A)/(xi*(B-A))))
term3 <- N*ifelse(N>=(xi*B)^(1/beta), 0, ifelse(N<=(xi*A)^(1/beta), 1, (xi*B-N^beta)/(xi*(B-A))))
# Compute expectation
lower <- ifelse(n^beta/xi<=A, A, ifelse(n^beta/xi>=B, B, n^beta/xi))
upper <- ifelse(N^beta/xi>=B, B, ifelse(N^beta/xi<=A, A, N^beta/xi))
term2 <- xi^(1/beta)*beta/(B-A)/(beta+1)*(upper^((beta+1)/beta)-lower^((beta+1)/beta))
# Compute phi
phi <- term1 + term2 + term3
# Construct results
results <- data.frame(
p = p,
phi = phi
)
return(results)
}
# User interface
ui <- fluidPage(
titlePanel("Agent average crop production for given water price."),
# Plot at the top, bigger
plotOutput("phiPlot", height = 400, width = 900),
# Sliders underneath
fluidRow(
column(2, sliderInput("n", "n", min = 0.1, max = 10, value = 5, step = 0.1)),
column(2, sliderInput("N", "N", min = 10, max = 50, value = 40, step = 0.1)),
column(2, sliderInput("A", "A", min = 5, max = 10, value = 9, step = 0.1))
),
