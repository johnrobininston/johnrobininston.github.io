server <- function(input, output) {
output$phiPlot <- renderPlot({
p_vals <- seq(0.1, 3, length.out = 200)
results <- do.call(rbind, lapply(p_vals, function(p) {
continuous_uniform_productivity(p, input$n, input$N, input$A, input$B, input$alpha, input$a, input$q)
}))
ggplot(results, aes(x = p, y = phi)) +
geom_line(size = .5) +
labs(
title = "Phi vs p",
x = "p",
y = expression(phi)
)  # larger font for clarity
}, res = 120)  # Higher resolution: default is 72; 120 is sharper
}
# Launch
shinyApp(ui = ui, server = server)
# User interface
ui <- fluidPage(
titlePanel("Interactive Plot Average agent production"),
# Plot at the top, bigger
plotOutput("phiPlot", height = 400, width = 900),
# Sliders underneath
fluidRow(
column(2, sliderInput("n", "n", min = 0.1, max = 10, value = 5, step = 0.1)),
column(2, sliderInput("N", "N", min = 10, max = 50, value = 40, step = 0.1)),
column(2, sliderInput("A", "A", min = 5, max = 10, value = 7, step = 0.1))
),
fluidRow(
column(2, sliderInput("B", "B", min = 10, max = 20, value = 15, step = 0.1)),
column(2, sliderInput("alpha", "alpha", min = 0.01, max = 0.99, value = 0.8, step = 0.01)),
column(2, sliderInput("a", "a", min = 0.1, max = 10, value = 2, step = 0.1))
),
fluidRow(
column(2, sliderInput("q", "q", min = 0.1, max = 10, value = 3, step = 0.1))
)
)
# Server
