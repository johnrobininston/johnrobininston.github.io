      "source": [
        "## LOOCV via the Hat Matrix"
      ],
      "id": "1cb92eef"
    },
    {
      "cell_type": "code",
      "metadata": {
        "output-location": "fragment"
      },
      "source": [
        "# LOOCV shortcut using the hat matrix\n",
        "X_aug = sm.add_constant(\n",
        "    df[['medinc','houseage','averooms','avebedrms',\n",
        "        'aveoccup','population','latitude','longitude']]\n",
        ")\n",
        "fit_full = sm.OLS(y_full, X_aug).fit()\n",
        "H        = X_aug @ np.linalg.solve(X_aug.T @ X_aug, X_aug.T)\n",
        "h_diag   = np.diag(H)\n",
        "e        = fit_full.resid\n",
        "\n",
        "loocv = np.mean((e / (1 - h_diag))**2)\n",
        "print(f\"LOOCV MSE (hat-matrix shortcut): {loocv:.4f}\")"
      ],
      "id": "b622a5f4",
