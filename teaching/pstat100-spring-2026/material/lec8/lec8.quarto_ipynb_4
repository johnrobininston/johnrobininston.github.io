        "#| fig-cap: Biased (n) vs. unbiased (n-1) sample variance estimators.\n",
        "rng = np.random.default_rng(7)\n",
        "true_var = 4.0\n",
        "biased, unbiased = [], []\n",
        "for _ in range(10_000):\n",
